# Default NVIDIA CUDA-graph runtime (./scripts/install.sh; ./start_server.sh).
# Copy to .env. Native shell: set -a; source .env; set +a
# Compose reads .env itself; its service environment lists supported overrides.
TTS_BACKEND=cuda_graphs
TTS_MODEL_ID=Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice
# TTS_MODEL_NAME takes precedence if set. TTS_MODEL_REVISION pins an HF commit.
# TTS_MODEL_REVISION=<full-model-commit>
# CONDA_EXE=/absolute/path/miniforge3/bin/conda
# TTS_FRONTEND_ENV=/absolute/path/miniforge3/envs/qwen3-tts
# TTS_GRAPH_ENV=/absolute/path/miniforge3/envs/qwen3-tts-graphs
# HF_HOME=/absolute/path/to/shared/huggingface/cache
# HF_HUB_OFFLINE=1

HOST=0.0.0.0
PORT=8880
# TTS_PORT is Compose's published host port; PORT is native API port.
TTS_PORT=8880
WORKERS=1
TTS_MAX_CONCURRENT=1
TTS_GRAPH_PORT=18881
TTS_STARTUP_TIMEOUT=900
# Private worker URL for independently managed API instances; launcher sets it.
# TTS_GRAPH_WORKER_URL=http://127.0.0.1:18881

# Graph capture and both generation paths warm inside the worker before API boot.
TTS_LAZY_LOAD=false
TTS_WARMUP_ON_START=false
TTS_IDLE_TIMEOUT_SECONDS=0
TTS_MIN_CHUNK_CHARS=200
TTS_MAX_CHUNK_CHARS=600
GPU_KEEPALIVE_INTERVAL=0
OMP_NUM_THREADS=8
TOKENIZERS_PARALLELISM=false
CORS_ORIGINS=*
ENABLE_VOICE_STUDIO=false
VOICE_LIBRARY_DIR=./voice_library

# Explicit alternatives (install their dependencies in dedicated environments).
# Official supports Base-model cloning; CUDA graphs support CustomVoice.
# TTS_BACKEND=official
# TTS_DEVICE=auto
# TTS_DTYPE=auto
# TTS_ATTN=auto

# CPU preset-speaker example:
# TTS_BACKEND=pytorch
# TTS_MODEL_ID=Qwen/Qwen3-TTS-12Hz-0.6B-CustomVoice
# TTS_DEVICE=cpu
# TTS_DTYPE=float32
# TTS_ATTN=sdpa
# CPU_THREADS=12
# CPU_INTEROP=2
# USE_IPEX=false

# Apple Silicon (use the dedicated MLX installation in README):
# TTS_BACKEND=mlx
# MLX_MODEL_ID=mlx-community/Qwen3-TTS-12Hz-0.6B-CustomVoice-8bit
# TTS_WARMUP_ON_START=true
# TTS_WARMUP_MAX_SECONDS=10

# vLLM/optimized/OpenVINO: see README and their backend guides.
